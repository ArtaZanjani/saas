{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:key": "mkdir -p keys && openssl genrsa -out keys/private.pem 2048 && openssl rsa -in keys/private.pem -pubout -out keys/public.pem",
    "docker:up": "docker compose up -d",
    "db:push": "pnpm prisma db push && pnpm prisma generate",
    "pre": "pnpm run docker:up && until docker exec saas-postgres pg_isready -U postgres -d saas; do sleep 1; done && pnpm run db:push",
    "dev": "pnpm run pre && next dev",
    "build": "pnpm run generate:key && pnpm run db:push && next build",
    "start": "next start",
    "lint": "eslint && knip"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "sharp": true,
    "unrs-resolver": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "formik": "^2.4.9",
    "iconsax-reactjs": "^0.0.8",
    "input-otp": "^1.4.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.24.0",
    "motion": "^12.40.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.8.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-pwa": "^3.0.2",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3",
    "zod-formik-adapter": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "knip": "^6.27.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}